# ── Analytos Brain configuration ─────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Actor bearer tokens — one per role; the server maps token → actor identity,
# Cedar maps actor → permissions. Generate each with:  openssl rand -hex 24
TOK_ADMIN=change-me-admin
TOK_REVIEWER=change-me-reviewer
TOK_INGEST=change-me-ingest
TOK_CONTENT=change-me-content
TOK_GTM=change-me-gtm

# Where the pipeline / console / agents find Omnigraph
OMNIGRAPH_BASE_URL=http://127.0.0.1:8080

# Role tokens as read by pipeline & agents (keep in sync with TOK_* above)
OMNIGRAPH_TOKEN_INGEST=${TOK_INGEST}
OMNIGRAPH_TOKEN_REVIEWER=${TOK_REVIEWER}
OMNIGRAPH_TOKEN_CONTENT=${TOK_CONTENT}
OMNIGRAPH_TOKEN_GTM=${TOK_GTM}

# ── LLM extraction (pipeline) ────────────────────────────────
# 'fixture' = deterministic keyless demo mode reading fixtures/<doc>.json.
# Unset EXTRACT_PROVIDER and set ONE key for real extraction
# (auto-detected: anthropic > openai > gemini).
EXTRACT_PROVIDER=fixture
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#EXTRACT_MODEL=claude-sonnet-4-5

# ── Agents' writing model ────────────────────────────────────
# 'none' = deterministic template mode. Otherwise anthropic|openai|gemini
# (falls back to the same keys as above).
#AGENT_PROVIDER=anthropic
#AGENT_MODEL=claude-sonnet-4-5

# ── Embeddings — MUST match between pipeline and server ──────
# mock = deterministic + keyless. For real semantics use gemini or an
# OpenAI-compatible endpoint, set identically on BOTH sides.
OMNIGRAPH_EMBED_PROVIDER=mock
#OMNIGRAPH_EMBED_MODEL=
#OMNIGRAPH_EMBED_BASE_URL=

# ── Review console auth (HTTP Basic) ─────────────────────────
APP_USER=reviewer
APP_PASSWORD=change-me-console

# ── Governance guardrail ─────────────────────────────────────
# Client names that must NEVER appear in agent output (comma-separated).
CLIENT_NAME_DENYLIST=GreenCart,greencartmarkets,MedNova,mednovadevices,Stuttgart
